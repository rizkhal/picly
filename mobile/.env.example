# Backend API base URL (auth + updates).
# - Local dev on Android with `adb reverse tcp:8000 tcp:8000`: http://localhost:8000
# - Physical device WITHOUT adb reverse: use your Mac's LAN IP, e.g. http://192.168.1.x:8000
#   (requires Docker to publish on 0.0.0.0, not just 127.0.0.1)
# - Android emulator: http://10.0.2.2:8000
# - Production: your deployed backend URL (e.g. https://api.picly.app)
EXPO_PUBLIC_API_URL=http://localhost:8000
