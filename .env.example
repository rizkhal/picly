# Picly environment (copy to .env)

# Postgres password
POSTGRES_PASSWORD=picly

# Host filesystem roots are mounted read-only into the API container under /host
# by docker-compose.yml: /Volumes (all external drives) and $HOME (user folder).
# The desktop app's "+ Add folder" scans any picked folder inside these roots in
# place (no copying).
#
# Colima/Lima: the same roots must ALSO be listed in colima.yaml `mounts` so the
# VM can see them — otherwise /host only shows the VM's own root filesystem:
#   mounts:
#     - location: /Volumes
#       writable: false
#     - location: /Users/you
#       writable: true
# (then `colima restart`). Docker Desktop on macOS auto-mounts these paths.
