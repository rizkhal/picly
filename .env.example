# Picly environment (copy to .env)

# --- Backend (Hono) ---
# JWT signing secret for auth tokens. REQUIRED in production — generate with:
#   openssl rand -base64 32
# If unset, an ephemeral secret is used (tokens invalidate on every restart).
JWT_SECRET=

# Where the SQLite DB lives. Default /data/picly.db (Docker volume).
# DB_PATH=/data/picly.db

# Backend listen port (default 8000)
# PORT=8000
