{
  "expo": {
    "name": "Picly",
    "slug": "picly-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo-128.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.picly.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Picly to access your photos to detect and group faces.",
        "NSCameraUsageDescription": "Allow Picly to use the camera to take photos for face clustering.",
        "NSPhotoLibraryAddUsageDescription": "Allow Picly to save cropped face thumbnails."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-128.png",
        "backgroundColor": "#111827"
      },
      "package": "com.picly.mobile",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-sqlite",
      "expo-file-system",
      "expo-media-library",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-128.png",
          "color": "#F97316"
        }
      ],
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-128.png",
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ]
    ],
    "primaryColor": "#111827"
  }
}
