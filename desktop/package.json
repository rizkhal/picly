{
  "name": "picly-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --strictPort\" \"wait-on -t 15000 http://localhost:5173 && NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "postinstall": "node scripts/fix-electron.mjs"
  },
  "build": {
    "appId": "com.picly.app",
    "productName": "Picly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Picly-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Picly-${version}.${ext}",
      "category": "Graphics"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Picly-${version}.${ext}",
      "category": "public.app-category.graphics-design"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "trustedDependencies": [
    "electron"
  ]
}
