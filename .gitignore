# Node / Electron (desktop)
node_modules/
packages/desktop/node_modules/
packages/desktop/dist/
packages/desktop/dist-main/
packages/desktop/out/
*.log

# Shared package build output
packages/shared/dist/
packages/ml/dist/

# Electron runtime artifacts (regenerated by scripts/fix-electron.mjs)
packages/desktop/Electron.app/
packages/desktop/LICENSE
packages/desktop/LICENSES.chromium.html
packages/desktop/version

# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/

/* Lockfiles — desktop keeps its own bun.lock; the npm workspace keeps package-lock.json.
   bun.lock appears at the root when bunx runs inside the npm workspace — never commit it. */
bun.lock

# OS
.DS_Store
Thumbs.db

# Uploads / runtime data
/tmp/
uploads/
*.db
packages/backend/data/

# Local sample data
/photos/

# Sample datasets (psdkp-sample-tile etc.)
/data/

# Local investigation crops (face-crop dumps for visual review — never commit)
assets/debug/
packages/desktop/assets/debug/
packages/mobile/assets/debug/

# Desktop local database + thumbnails
/packages/desktop/data/

# Web (landing page)
packages/web/node_modules/
packages/web/dist/
packages/web/*.tsbuildinfo

# Bundled ONNX models (~190MB, never commit — fetched by scripts/fetch-models.mjs)
/models/
# npm lockfile (project uses bun.lock; CI runs npm install without lockfile)
packages/desktop/package-lock.json
