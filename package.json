{
  "name": "picly",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/mobile",
    "packages/web",
    "packages/shared",
    "packages/ml"
  ],
  "scripts": {
    "install:all": "npm install",
    "start:mobile": "npm run start --workspace=packages/mobile",
    "start:backend": "bun run dev --workspace=packages/backend",
    "start:web": "npm run dev --workspace=packages/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:ml": "npm run build --workspace=packages/ml",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "patch-package --patch-dir packages/mobile/patches",
    "clean:all": "rm -rf node_modules packages/backend/node_modules packages/desktop/node_modules packages/mobile/node_modules packages/web/node_modules packages/shared/node_modules packages/ml/node_modules"
  },
  "dependencies": {
    "ws": "8"
  }
}
